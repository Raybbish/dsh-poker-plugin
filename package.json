{
  "name": "dsh-poker",
  "version": "0.1.0",
  "description": "An unofficial local multiplayer Texas Hold'em plugin for the DSH Web UI, with optional server-side AI players.",
  "homepage": "https://github.com/Raybbish/dsh-poker-plugin#readme",
  "bugs": {
    "url": "https://github.com/Raybbish/dsh-poker-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raybbish/dsh-poker-plugin.git"
  },
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./engine": {
      "types": "./lib/types/engine/index.d.ts",
      "default": "./lib/engine/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test \"dist-test/test/*.test.js\"",
    "test:only": "node --test \"dist-test/test/*.test.js\"",
    "test:install": "bash scripts/install-test.sh",
    "test:ui": "node --test test/ui-overlap.test.mjs && node --test test/ui-layout.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
